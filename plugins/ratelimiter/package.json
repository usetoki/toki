{
  "name": "@usetoki/toki-ratelimiter",
  "version": "0.1.2",
  "description": "Flexible per-route, per-key rate limiting for toki — a JS limiter with custom keys and pluggable stores.",
  "license": "MIT",
  "author": "Mohammad Almoghrabi <deounix@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetoki/toki.git",
    "directory": "plugins/ratelimiter"
  },
  "homepage": "https://usetoki.github.io/toki/",
  "bugs": "https://github.com/usetoki/toki/issues",
  "keywords": [
    "toki",
    "rate-limit",
    "ratelimiter",
    "throttle",
    "per-route",
    "middleware"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --test-force-exit __test__/*.test.ts"
  },
  "peerDependencies": {
    "@usetoki/toki": ">=0.2.0"
  },
  "devDependencies": {
    "@usetoki/toki": "file:../.."
  }
}
