{
  "name": "@usetoki/toki-env",
  "version": "0.1.0",
  "description": "Validate and coerce environment variables at boot into a typed, frozen config — zero dependencies.",
  "license": "MIT",
  "author": "Mohammad Almoghrabi <deounix@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetoki/toki.git",
    "directory": "plugins/env"
  },
  "homepage": "https://usetoki.github.io/toki/",
  "bugs": "https://github.com/usetoki/toki/issues",
  "keywords": [
    "toki",
    "env",
    "environment",
    "config",
    "validation",
    "dotenv"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --test-force-exit __test__/*.test.ts"
  }
}
